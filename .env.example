# Tribün — ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayıp değerleri kendine göre değiştir:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# Sunucunun dinleyeceği port
PORT=3000

# JWT imza anahtarı — UZUN ve RASTGELE bir metin yaz, kimseyle paylaşma
JWT_SECRET=buraya-cok-gizli-uzun-bir-anahtar-yaz

# Admin paneli (/admin.html) için gizli anahtar
ADMIN_KEY=tribun-admin-anahtari

# (Opsiyonel) Giriş/kayıt istek limiti, 15 dakikalık pencere (varsayılan: 20)
# Lokalde yoğun test yapacaksan yükseltebilirsin.
AUTH_RATE_LIMIT=50

# ---- SportScore (spor verisi; Aşama 1) ----
# Senkron kapalı başlar; sonraki aşamalarda açılır
SPORTS_SYNC_ENABLED=false
SPORTSCORE_BASE_URL=https://sportscore.com
# Günde yapılabilecek en fazla SportScore isteği (güvenlik tavanı)
SPORTSCORE_DAILY_BUDGET=7000
# Tek isteğin zaman aşımı (ms)
SPORTSCORE_TIMEOUT_MS=10000

# Detay çağrıları için günlük ayrı tavan (AŞAMA 8)
SPORTSCORE_DETAIL_DAILY_CAP=1000
